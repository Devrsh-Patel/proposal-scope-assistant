# =============================================================================
# Proposal & Scope-of-Work Drafting Assistant — Environment Variables
# Scalezix Ventures LLP — Project 1
# =============================================================================
# Copy this file to .env.local to configure your local development environment.
# Never commit real API keys or secrets to version control.
# =============================================================================

# AI Provider API Key (OpenAI-compatible)
# Optional: If omitted or empty, the application runs entirely in rule-based mode.
VITE_AI_API_KEY=your_openai_or_compatible_api_key_here

# AI Provider Base URL
# Default: https://api.openai.com/v1
# Supports local/compatible providers like Ollama (http://localhost:11434/v1), Groq (https://api.groq.com/openai/v1), etc.
VITE_AI_BASE_URL=https://api.openai.com/v1

# AI Model Identifier
# Default: gpt-4o-mini
VITE_AI_MODEL=gpt-4o-mini

